# Shell/Compose settings. Backend secrets stay in backend/.env or your platform's secret store.
# Source these values into your shell or use --env-file with Docker Compose.
APP_ENV=production
FRONTEND_ORIGIN=https://rag.example.com
APP_PORT=3000
# On Linux, use an absolute persistent directory writable by UID/GID 10001.
PDF_STORAGE_PATH=/srv/securerag/pdfs
# For a private S3-compatible PDF bucket, set all five values.
# PDF_S3_BUCKET=securerag-pdfs
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
