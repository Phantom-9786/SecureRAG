APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Copy both URLs from your Neon DEVELOPMENT branch. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Schema is fixed at 1536 dimensions. Changing it requires a migration/re-embedding.
EMBEDDING_DIMENSIONS=1536
PDF_STORAGE_ROOT=./storage/pdfs
# Generate once: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set this before login/bootstrap. Never use the example text as a real secret.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
# Optional Google Identity Services Web application OAuth Client ID (not a Gemini key).
GOOGLE_CLIENT_ID=
# Gemini Developer API; keep real API keys only in ignored .env.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHARACTERS=500000
MAX_DOCUMENT_CHUNKS=300
EMBEDDING_TIMEOUT_SECONDS=30
INGESTION_TIMEOUT_SECONDS=120

# Optional peer keys. Fill actual Cloud project IDs from AI Studio, not account email addresses.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_PROJECT_ID=shared-project
GEMINI_PROJECT_ID_2=shared-project
GEMINI_PROJECT_ID_3=shared-project
# App-local defaults only; configure within the actual API quotas for each project/model.
GEMINI_DEFAULT_RPM=5
GEMINI_DEFAULT_TPM=10000
GEMINI_DEFAULT_RPD=100
GEMINI_MAX_PARALLEL_REQUESTS=3
GEMINI_MAX_WAIT_SECONDS=5
# Optional JSON overrides; include one object per project/model with project_id, model, rpm, tpm, rpd.
GEMINI_RATE_LIMITS=[]
# Set model IDs after confirming access on your API projects. No model is picked from a subscription name.
GEMINI_BASIC_MODEL=
GEMINI_ADVANCED_MODEL=
# Optional for models supporting thinking levels. Leave empty for unsupported model families.
GEMINI_ADVANCED_THINKING_LEVEL=
GEMINI_GENERATION_TIMEOUT_SECONDS=60
# Retrieval operates only on active/ready documents in the user's current DB category scope.
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.60
RAG_CONTEXT_MAX_BYTES=6000
